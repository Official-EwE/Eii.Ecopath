!0.29.langVBScript
!0.29.textÿFlag = Installer.Variables("REG:HKLM\Software\Microsoft\NET Framework Setup\NDP\v4\Full\Install")
If Flag="" Then
  res = Installer.ShowMessage("Ecopath with Ecosim requires the Microsoft .NET 4.0 framework. Do you wish to download and install this now?", ".NET framework update required", vbYesNo + vbExclamation)
  If res = vbYes Then
    Installer.RunProgram "http://www.microsoft.com/downloads/details.aspx?familyid=0A391ABD-25C1-4FC0-919F-B21F31AB88B7&displaylang=en ", "", false
    Installer.CancelInstall
  End If
End If
