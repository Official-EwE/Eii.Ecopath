  <ItemGroup>
    <Folder Include="Plugins\ResultWriters\" />
  </ItemGroup>
  <ItemGroup>
    <Service Include="{94E38DFF-614B-4CBD-B67C-F211BB35CE8B}" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- To modify your build process, add your task inside one of the targets below and uncomment it. 
       Other similar extension points exist, see Microsoft.Common.targets.
  -->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
    <ItemGroup>
      <_FilesGDAL32 Include="Spatial\Includes\DotSpatial\GDAL32\**\*.dll" />
      <_FilesGDAL64 Include="Spatial\Includes\DotSpatial\GDAL64\**\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_FilesGDAL32)" DestinationFiles="@(_FilesGDAL32->'$(OutputPath)\GDAL32\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_FilesGDAL64)" DestinationFiles="@(_FilesGDAL64->'$(OutputPath)\GDAL64\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Message Text="Copied GDAL files: @(SourceFiles)" />
  </Target>
  <PropertyGroup>
    <CopyAllFilesToSingleFolderForPackageDependsOn>
      Collect_FilesGDAL32;
      $(CopyAllFilesToSingleFolderForPackageDependsOn);
    </CopyAllFilesToSingleFolderForPackageDependsOn>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>
    </PostBuildEvent>
  </PropertyGroup>
</Project>