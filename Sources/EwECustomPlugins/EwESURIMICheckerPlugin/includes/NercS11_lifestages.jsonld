      "pav:version": "1",
      "skos:notation": "SDN:S11::S1193",
      "skos:altLabel": "",
      "dc:date": "2021-08-24 11:24:18.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "veliger"
      },
      "dc:identifier": "SDN:S11::S1193",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Planktonic larva typical of many marine and freshwater snails and bivalves. The veliger develops from the trochophore larva."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1106/",
      "pav:authoredOn": "2025-05-27 12:45:21.0",
