      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "pupa"
      },
      "dc:identifier": "SDN:S11::S1180",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "An organism at the pupal stage. A life stage of some insects undergoing a complete metamorphosis between immature (larva) and mature (adult or imago) stages."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1102/",
      "pav:hasVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1102/1/"
