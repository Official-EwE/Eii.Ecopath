      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fish life stage between the start of notochord flexion and until complete notochord flexion. This is concurrent with development of the caudal-fin rays and supporting skeletal elements."
      },
      "@type": "skos:Concept"
    },
    {
