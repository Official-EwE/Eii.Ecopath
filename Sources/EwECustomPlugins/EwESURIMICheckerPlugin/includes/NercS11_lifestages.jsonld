      "skos:prefLabel": {
        "@language": "en",
        "@value": "embryo"
      },
      "dc:identifier": "SDN:S11::S1106",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The developing unborn or unhatched offspring of a multicellular organism."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1190/",
      "pav:hasVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1190/1/"
      },
      "pav:authoredOn": "2025-06-27 15:45:59.0",
      "pav:hasCurrentVersion": {
