<!--
  ============================================================
  DEBUG SYMBOLS / STEP-THROUGH DEBUGGING — NOTES
  ============================================================
  Current setup: DebugType=embedded + EmbedAllSources=true
    - Works fully offline, no auth needed.
    - Applies to both Debug and Release (not split out).

  TODO: move to Source Link instead of embedding sources in the package.
  This is a more modern approach that avoids shipping source files
  in the package itself, and instead fetches them from the GitHub repo
  at the exact commit SHA of the build.
  This requires consumers to have GitHub auth configured locally.

  Trade-off vs current setup:
    + Smaller package (no baked-in source files)
    + Source always matches the exact commit SHA, not whatever was
      packed at build time
    - Every consumer must have valid GitHub auth configured locally,
      or step-through just silently fails to load source
    - No free public symbol server (nuget.org's only indexes public
      packages) — snupkg has nowhere to go unless we host one

  === MSBuild changes to make ===
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  Remove: <EmbedAllSources>true</EmbedAllSources> (no longer needed —
  source is fetched from GitHub instead of baked in)

  === Symbols: skip snupkg, embed portable PDB in the package instead ===
  Since there's no symbol server for a private repo (GitHub Packages
  doesn't run one, nuget.org won't index a private repo's symbols),
  don't bother with SymbolPackageFormat=snupkg / IncludeSymbols. Just
  ship a portable PDB alongside the DLL in the main package:

  <PropertyGroup>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  This keeps symbol resolution simple (PDB is already local, right next
  to the DLL) — the only remaining "fetch" step is Source Link pulling
  the .cs files themselves from GitHub when a breakpoint/step needs them.

  === Debug vs Release split ===
  Local Debug builds (dirty tree / unpushed commits) won't resolve
  cleanly via Source Link anyway — only meaningful for builds built
  from a pushed commit SHA. Recommend:

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  === Consumer-side setup (this is the part that actually matters now) ===
  Because the repo is private, raw.githubusercontent.com will 404/401
  for unauthenticated requests, so every machine that wants to step
  into this source needs GitHub credentials wired up:

  1. Install/rely on Git Credential Manager (GCM) — bundled with recent
     Git for Windows and VS installs. Confirm with:
       git config ––global credential.helper
     (should show "manager" or "manager-core")

  2. One-time per machine: trigger a GitHub auth prompt so GCM caches
     a token. Easiest way is a throwaway private clone/fetch:
       git ls-remote https://github.com/Official-EwE/Eii.Ecopath.git
     This pops the GCM browser/device-code login. Needs a GitHub
     account with at least read access to the repo. GCM stores the
     resulting token in Windows Credential Manager (or platform
     equivalent on macOS/Linux) — no PAT to manage manually in the
     common case.

  3. Alternative if GCM isn't available/allowed (e.g. locked-down
     machine, CI agent): use a fine-grained PAT with "Contents: read"
     on this repo, and store it via:
       git config ––global credential.https://github.com.username <gh-user>
     and let the credential store prompt once, pasting the PAT as the
     password. Or set it non-interactively via an env var pattern like
     GIT_ASKPASS pointing to a small script that echoes the PAT — useful
     for build agents that need to symbolicate crash dumps later.

  4. In Visual Studio (Tools > Options > Debugging > General):
       - Uncheck "Enable Just My Code"
       - Check "Enable Source Link support"
     VS will use the same credential store as Git for the fetch, so if
     step 1/3 worked, no extra VS-side auth needed.

  5. Sanity check: set a breakpoint in consuming code, step into an
     Eii.Ecopath call. First hit will show a brief "Source Link" fetch
     in the status bar; if it instead prompts a login dialog or fails
     silently with "no source available," credentials aren't wired up
     — revisit step 1–3 before assuming Source Link itself is broken.

  Known friction: this must be repeated (or scripted/documented for
  onboarding) on every new dev machine and any CI agent that needs to
  symbolicate crashes against private source. Budget for that when
  deciding if this is worth it over just keeping embedded sources.
  ============================================================
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <Platforms>x86;x64;AnyCPU</Platforms>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>EwECore.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <AssemblyName>EwECore</AssemblyName>
    <RootNamespace>EwECore</RootNamespace>
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64</RuntimeIdentifiers>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Eii.Ecopath.EwECore</PackageId>
    <Title>Ecopath with Ecosim Core</Title>
    <Description>A description of the EwECore package</Description>
    <PackageProjectUrl>https://github.com/Official-EwE/Eii.Ecopath.EwECore</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Official-EwE/Eii.Ecopath</RepositoryUrl>
    <PackageReleaseNotes>Fixed minor bugs and improved performance.</PackageReleaseNotes>
	<DebugType>embedded</DebugType>
    <IncludeSource>true</IncludeSource>
    <IncludeReferencedProjects>True</IncludeReferencedProjects>
    <Company>EII</Company>
    <PackageIcon>EII_plain_128x128.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\EII_plain_128x128.png" Pack="True" PackagePath="\" />
    <None Include="Includes\*.*" Pack="true" PackagePath="Includes\" />
  </ItemGroup>
	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="EwEUtils" />
		<Import Include="EwEUtils.Logging" />
	</ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
	<PlatformTarget>AnyCPU</PlatformTarget>
    <DocumentationFile>EwECore.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <WarningsAsErrors></WarningsAsErrors>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
	<PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>None</DebugType>
    <DefineDebug>false</DefineDebug>
    <DocumentationFile>EwECore.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <WarningsAsErrors></WarningsAsErrors>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
   <DocumentationFile>EwECore.xml</DocumentationFile>
    <RegisterForComInterop>false</RegisterForComInterop>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <DefineConstants>DISCARDS=1</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <DocumentationFile>EwECore.xml</DocumentationFile>
    <RegisterForComInterop>false</RegisterForComInterop>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DocumentationFile>EwECore.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <DefineConstants></DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <DocumentationFile>EwECore.xml</DocumentationFile>
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42030,42032,42036,42104,42108,42109,42353,42354,42355</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Interop.JRO, Version=2.6.0.0, Culture=neutral, PublicKeyToken=1d875393b3ebcad0, processorArchitecture=MSIL" />
    <Reference Include="Microsoft.Office.interop.access.dao, Version=12.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c" />
    <Reference Update="System">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7\System.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Import Include="System.Data" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
     <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Compile Update="Resources\CoreDefaults.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>CoreDefaults.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\CoreMessages.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>CoreMessages.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\CoreMessages.resx">
      <SubType>Designer</SubType>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>CoreMessages.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Class Diagrams\Core Ecopath.cd">
      <SubType></SubType>
    </None>
    <None Update="Class Diagrams\Core Input-Output.cd">
      <SubType></SubType>
    </None>
    <None Update="Class Diagrams\Message Handlers.cd">
      <SubType></SubType>
    </None>
    <None Update="Includes\LPSolve\win32\lpsolve55.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Includes\LPSolve\win64\lpsolve55.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
    <EmbeddedResource Include="Resources\EwE6.accdb" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\CoreDefaults.resx">
      <SubType>Designer</SubType>
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>CoreDefaults.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\EwE6.mdb"></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Includes\Interop.JRO.dll" />
    <Content Include="Includes\Microsoft.Office.interop.access.dao.dll" />
    <Content Include="Resources\LICENSE.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Eii.Ecopath.Storage" Version="0.0.12" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Eii.Ecopath.Licence" Version="1.0.3" />
  </ItemGroup>    
  <ItemGroup>
    <Compile Remove="EcoSpace\Input Output\ResultWriters\Data sources\cRegionTLResultsDataSource.vb" />
    <Compile Remove="Shapes\TimeSeries\Readers\cTimeSeriesClipboardReader.vb" />
    <Compile Remove="Validators\cValidatorOutput.vb" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9">
          <PrivateAssets>none</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9">
          <PrivateAssets>none</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.9">
          <PrivateAssets>none</PrivateAssets>
      </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
      <PackageReference Include="EntityFramework" Version="6.5.2" />
      <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
      <PackageReference Include="System.Data.SQLite.EF6" Version="2.0.3" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <PackageReference Include="System.ServiceModel.Primitives">
      <Version>10.0.652802</Version>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
  <!-- Use a local project reference when UseProjectReferences is true -->
  <ItemGroup Condition="'$(UseProjectReferences)' == 'true'">
    <ProjectReference Include="..\EwEUtils\EwEUtils.vbproj" />
  </ItemGroup>
  <!-- Otherwise use a package reference.  -->
  <ItemGroup>
    <PackageReference Include="Eii.Ecopath.EwEUtils" Version="6.7.*" />
  </ItemGroup>
</Project>
