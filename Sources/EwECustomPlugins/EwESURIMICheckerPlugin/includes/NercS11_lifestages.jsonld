      "skos:altLabel": "megalopae+adult",
      "dc:date": "2025-06-27 15:45:59.0",
      "owl:versionInfo": "2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "megalopa+adult"
      },
      "dc:identifier": "SDN:S11::S1198",
      "skos:note": {
        "@language": "en",
