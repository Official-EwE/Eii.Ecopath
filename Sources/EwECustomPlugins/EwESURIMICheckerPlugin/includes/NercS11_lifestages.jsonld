      "skos:definition": {
        "@language": "en",
        "@value": "A fish life stage between hatching and until complete absorption of yolk-sac."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1197/",
