      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fish life stage between complete yolk-sac absorption and until the start of notochord flexion."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1192/",
      "pav:authoredOn": "2021-08-24 11:19:16.0",
      "pav:hasCurrentVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1192/1/"
      },
      "dce:identifier": "SDN:S11::S1192",
      "pav:version": "1",
      "skos:notation": "SDN:S11::S1192",
      "skos:altLabel": "",
      "dc:date": "2021-08-24 11:19:16.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "trochophore"
      },
      "dc:identifier": "SDN:S11::S1192",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Free-swimming planktonic marine larva occurring in the first developmental stage of Molluscs and certain marine annelids. The trochophore is the developmental stage prior to veliger."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1105/",
      "pav:authoredOn": "2023-11-10 11:57:29.0",
      "pav:hasCurrentVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1105/1/"
      },
      "dce:identifier": "SDN:S11::S1105",
      "pav:version": "1",
      "skos:notation": "SDN:S11::S1105",
      "skos:altLabel": "first larval instar",
      "dc:date": "2023-11-10 11:57:29.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "first juvenile instar"
      },
      "dc:identifier": "SDN:S11::S1105",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The first-juvenile instar is the first developmental phase for certain juvenile arthropods and crustaceans. Larval development typically consists of series of stages in which each stage is separated from the next by a molt. An instar is usually defined as the period between molts (ecdyses), and synonymous to the first developmental phase in the juvenile lifestage."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1172/",
      "pav:hasVersion": {
