      },
      "dce:identifier": "SDN:S11::S1176",
      "pav:version": "1",
      "owl:sameAs": {
        "@id": "http://purl.obolibrary.org/obo/UBERON_0018385"
      },
      "skos:notation": "SDN:S11::S1176",
      "skos:altLabel": "",
      "dc:date": "2019-08-23 13:10:12.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "metacercaria"
      },
      "dc:identifier": "SDN:S11::S1176",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A resting late larval stage of the digenetic trematodes (digeneans) with a three-host life cycle. It is a tailless stage which develops in the intermediate host either encysted in a cyst or encapsulated in a layer of host tissue. This is usually the form which is infective to the definitive host when it ingests the infected intermediate host."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1179/",
      "pav:authoredOn": "2019-08-29 18:04:40.0",
      "pav:hasCurrentVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1179/1/"
      },
      "dce:identifier": "SDN:S11::S1179",
      "pav:version": "1",
      "skos:notation": "SDN:S11::S1179",
      "skos:altLabel": "ephyrula",
      "dc:date": "2019-08-29 18:04:40.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "ephyra"
      },
      "dc:identifier": "SDN:S11::S1179",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A free-swimming precursor stage of the adult medusa stage, ephyrae (or ephyrulae) are small medusae (\"medusoid heads\") that separate from the polyp by budding in a process known as strobilation before metamorphosing into scyphomedusae, the life stage of the adult medusa typically identified as jellyfish. Strobils can sometimes become scyphomedusae without passing through the ephyra stage."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1198/",
      "pav:hasVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1198/1/"
