    Private Sub Invalidate()
        'Console.WriteLine("L: I")
        Me.m_refresh = Date.MinValue
    End Sub

    Private Sub Refresh()

        If (Date.Now - Me.m_refresh).TotalHours > 1 Then

            Me.m_bValidCached = False
            Me.m_lictypeCached = eLicenseType.NotSet
            Me.m_expCached = Date.MinValue
            Me.m_ownCached = ""

            'Console.WriteLine("L: R")
            Try
                If (Me.m_engine.OnlineRevocationCheck()) Then
                    Me.m_engine.AsyncSilentReactivation()
                End If
            Catch ex As Exception
                ' Whoah
            End Try
            Me.m_bValidCached = Me.m_engine.IsLicenseValid()

            Dim lic As TreeksLicensingLibrary2.License = Me.m_engine.MyLicense
            If (lic IsNot Nothing) Then
                If lic.AllowedFeatures.Contains("team") Or lic.ProductName.ToLower().Contains("team") Then
                    Me.m_lictypeCached = eLicenseType.Team
                End If
                If lic.AllowedFeatures.Contains("single") Or lic.ProductName.ToLower().Contains("ind") Then
                    Me.m_lictypeCached = eLicenseType.Individual
                End If

                If lic.ExpirationDateEnabled Then
                    Me.m_expCached = lic.ExpirationDate
                Else
                    Me.m_expCached = Date.MaxValue
                End If

                Me.m_ownCached = lic.OwnerName
            End If
            Me.m_refresh = Date.Now
        Else
            'Console.WriteLine("L: C")
        End If
    End Sub

