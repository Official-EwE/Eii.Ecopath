<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="3.5">
  <PropertyGroup>
    <!-- The configuration and platform will be used to determine which
         assemblies to include from solution and project documentation
         sources -->
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{47067ab1-424a-4acb-8dd5-f38666499c64}</ProjectGuid>
    <SHFBSchemaVersion>1.8.0.3</SHFBSchemaVersion>
    <!-- AssemblyName, Name, and RootNamespace are not used by SHFB but Visual
         Studio adds them anyway -->
    <AssemblyName>Documentation</AssemblyName>
    <RootNamespace>Documentation</RootNamespace>
    <Name>Documentation</Name>
    <!-- SHFB properties -->
    <OutputPath>.\Help\</OutputPath>
    <HtmlHelpName>EwE6_UI_shared</HtmlHelpName>
    <CopyrightText>Copyright %28c%29 UBC Fisheries Centre 2007 - 2010</CopyrightText>
    <HelpTitle>EwE6 Shared UI Class Library</HelpTitle>
    <HelpFileVersion>6.0.7.0310</HelpFileVersion>
    <SandcastlePath>C:\Program Files\Sandcastle\</SandcastlePath>
    <WorkingPath>Temp\</WorkingPath>
    <HtmlHelp1xCompilerPath>..\..\..\..\..\Program Files\HTML Help Workshop\</HtmlHelp1xCompilerPath>
    <DocumentationSources>
      <DocumentationSource sourceFile="..\ScientificInterfaceShared\ScientificInterfaceShared.vbproj" />
    </DocumentationSources>
    <NamespaceSummaries>
      <NamespaceSummaryItem name="(global)" isDocumented="False">EwE API Code Documentation</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore" isDocumented="False">Namespace containing all elements essential to the functioning of the EwE computing engine.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.Auxiliary" isDocumented="False">Namespace containing loose-typed, auxillary elements for the EwE computational core.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.Database" isDocumented="False">Namespace containing all elements required by the EwE core to databases.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEPlugin" isDocumented="False">Namespace containing all elements required when implementing or accessing EwE plug-ins.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils" isDocumented="False">Namespace containing shared definitions and helper classes for EwE applications.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Commands" isDocumented="False">Namespace containing all elements required for EwE applications to fire and handle generic commands.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Core" isDocumented="False">Namspace containing EwE core utility classes and definitions.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Database" isDocumented="False">Namspace containing database utility classes and definitions.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Drawing" isDocumented="False">Namspace containing drawing and rendering utility classes and definitions.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.NetUtilities" isDocumented="False">Namspace containing networking utility classes and definitions.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Utilities" isDocumented="False">Namespace with generic utility classes and definitions.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.Win32Api" isDocumented="False">Namespace containing interfaces to the Win32 API.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.Ecopath" isDocumented="False">Namespace containing all elements essential to the functioning of the Ecopath model.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.Ecosim" isDocumented="False">Namespace containing all elements essential to the functioning of the Ecosim model.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.FitToTimeSeries" isDocumented="False">Namespace containing fit to time series search logic.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.MSE" isDocumented="False">Namespace containing elements for implementing Searches in the EwE computational core.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.SearchObjectives" isDocumented="False">Namespace containing elements for implementing Searches in the EwE computational core.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.DataSources" isDocumented="False">Namespace containing elements for creating data sources.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.FishingPolicy" isDocumented="False">Namespace containing elements for managing fishing policy runs.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwECore.ValueWrapper" isDocumented="False">Namespace containing elements for wraping variables and associated data.</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEPlugin.Data" isDocumented="False">Namespace containing functionlity for accesssing plugin data</NamespaceSummaryItem>
<NamespaceSummaryItem name="EwEUtils.SystemUtilities" isDocumented="False">Namespace containing elements for accessing assembly information.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared" isDocumented="True">Namespace containing all components for implementing user interfaces in EwE6.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Controls" isDocumented="True">Namespace containing form controls for implementing user interfaces in EwE6.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Controls.EwEGrid" isDocumented="True">Namespace containing all components for implementing standardized data grids in EwE6.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Controls.Wizard" isDocumented="True">Namespace containing all components for implementing stepwise wizards in EwE6.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Definitions" isDocumented="True">Namespace containing common definitions for the EwE6 shared interface library.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Properties" isDocumented="True">Namespace offering observer-pattern based data monitors or 'properties' to simplify the process of building interfaces.</NamespaceSummaryItem>
<NamespaceSummaryItem name="ScientificInterfaceShared.Style" isDocumented="True">Namespace containing style definitions for EwE6 interfaces.</NamespaceSummaryItem></NamespaceSummaries>
    <ProjectSummary>API documentation for the Ecopath with Ecosim version 6 shared user interface components.</ProjectSummary>
    <FeedbackEMailAddress>ewedevteam%40gmail.com</FeedbackEMailAddress>
    <FeedbackEMailLinkText>EwE development support</FeedbackEMailLinkText>
    <RootNamespaceContainer>True</RootNamespaceContainer>
    <IncludeFavorites>True</IncludeFavorites>
  </PropertyGroup>
  <!-- There are no properties for these two groups but they need to appear in
       order for Visual Studio to perform the build. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EwEUtils\EwEUtils.vbproj">
      <Name>EwEUtils</Name>
      <Project>{5C331318-C23E-4EEB-AD1E-2EDEF85E0205}</Project>
    </ProjectReference>
    <ProjectReference Include="..\EwEPlugin\EwEPlugin.vbproj">
      <Name>EwEPlugin</Name>
      <Project>{0B91F6E0-6127-4CF3-BF57-684092481454}</Project>
    </ProjectReference>
    <ProjectReference Include="..\EwECore\EwECore.vbproj">
      <Name>EwECore</Name>
      <Project>{CDECE065-503A-4562-A955-06777B2F909E}</Project>
    </ProjectReference>
  </ItemGroup>
  <!-- Import the SHFB build targets -->
  <Import Project="$(SHFBROOT)\SandcastleHelpFileBuilder.targets" />
</Project>