  <data name="CONVERTER_AREARASTER_DESCR" xml:space="preserve">
    <value>Plugin that converts GISvector data to a Ecospace raster containing polygon/cell area cell overlap ratios. For this, every cell area / polygon area overlap ratio is calculated, and the ratio [0, 1] is stored in the raster. This method becomes slow for large polygon data sets.</value>
  </data>
  <data name="CONVERTER_AREARASTER_NAME" xml:space="preserve">
    <value>Area ratio converter</value>
  </data>
  <data name="CONVERTER_DIRECTRASTER_DESCR" xml:space="preserve">
    <value>Plugin that converts GIS raster or polygon data to a value raster compatible with Ecospace. In case of raster data, executed GIS raster operations are Clip and Resample. In case of vector data a given attribute in the polygon dataset is rendered and converted to raster on pixel-to-cell basis.</value>
  </data>
  <data name="CONVERTER_DIRECTRASTER_NAME" xml:space="preserve">
    <value>Simple raster converter</value>
  </data>
  <data name="CONVERTER_DIRECTVECTOR_DESCR" xml:space="preserve">
    <value>Plugin that converts GIS polygon attribute values to a value raster compatible with Ecospace.</value>
  </data>
  <data name="CONVERTER_DIRECTVECTOR_NAME" xml:space="preserve">
    <value>Simple vector converter</value>
  </data>
  <data name="DATASET_ASCII_DESCRIPTION" xml:space="preserve">
    <value>Plugin that implements access to a series of ASCII map files over time.</value>
  </data>
  <data name="DATASET_ASCII_NAME" xml:space="preserve">
    <value>A series of ASCII maps over time</value>
  </data>
  <data name="DATASET_MULTIPLE_DESCR" xml:space="preserve">
