    Public ReadOnly Property IsRegistered() As Boolean
        Get
            Dim lic As TreeksLicensingLibrary2.License = Me.License
            If (lic Is Nothing) Then
                Try
                    If Me.m_lic.ShowRegistrationForm(Nothing, "EwE Pro") = Windows.Forms.DialogResult.OK Then
                    End If
                Catch ex As Exception

                End Try
            End If
            Return (Me.m_lic IsNot Nothing)
        End Get
    End Property

    Public Function IsLicensed() As Boolean
        If (Me.m_lic.OnlineRevocationCheck()) Then
            Me.m_lic.AsyncSilentReactivation()
        End If
        Return Me.m_lic.IsLicenseValid()
    End Function

    Public Function Expiry() As Date
        Dim lic As TreeksLicensingLibrary2.License = Me.License
        If (lic Is Nothing) Then Return Date.Now
        Return lic.ExpirationDate
    End Function

