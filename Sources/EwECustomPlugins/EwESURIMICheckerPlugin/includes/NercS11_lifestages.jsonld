      "pav:version": "2",
      "skos:notation": "SDN:S11::S1190",
      "skos:altLabel": "",
      "dc:date": "2025-06-27 15:45:59.0",
      "owl:versionInfo": "2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "postflexion larva"
      },
      "dc:identifier": "SDN:S11::S1190",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A fish life stage between the completion of notochord flexion and until the start of metamorphosis. Diagnostic characteristics include formation of the caudal fin and attainment of meristic complements such as fin rays."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1175/",
      "pav:authoredOn": "2019-08-23 13:04:46.0",
      "pav:hasCurrentVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1175/1/"
      },
      "dce:identifier": "SDN:S11::S1175",
      "pav:version": "1",
      "skos:notation": "SDN:S11::S1175",
      "skos:altLabel": "",
      "dc:date": "2019-08-23 13:04:46.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "cercaria purpurea"
      },
      "dc:identifier": "SDN:S11::S1175",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The larval stage of the trematode Parorchis acanthus (urn:lsid:marinespecies.org:taxname:158687), a parasitic castrator of the common periwinkle Littorina littorea (urn:lsid:marinespecies.org:taxname:140262). Trematoda is a clade within the phylum Platyhelminthes. It includes two groups of parasitic flatworms, known as flukes. They are internal parasites of molluscs and vertebrates."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1180/",
      "pav:authoredOn": "2019-11-15 17:58:54.0",
      "pav:hasCurrentVersion": {
