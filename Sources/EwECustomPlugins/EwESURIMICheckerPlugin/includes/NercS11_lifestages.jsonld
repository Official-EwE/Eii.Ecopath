      "skos:prefLabel": {
        "@language": "en",
        "@value": "pilidium larva"
      },
      "dc:identifier": "SDN:S11::S1102",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Larval stage of both Nemertea and Spiralia in which the developing juvenile has a gut which lies across the larva's body, and usually eats the remains of the larva when it emerges."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1196/",
      "pav:authoredOn": "2021-08-24 12:13:11.0",
      "pav:hasCurrentVersion": {
        "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1196/1/"
      },
      "dce:identifier": "SDN:S11::S1196",
      "pav:version": "1",
      "skos:notation": "SDN:S11::S1196",
      "skos:altLabel": "",
      "dc:date": "2021-08-24 12:13:11.0",
      "owl:versionInfo": "1",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "nurse"
      },
      "dc:identifier": "SDN:S11::S1196",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A developmental stage in the life cycle of doliolids (Order Doliolida). The nurse stage is the terminal life stage for doliolids, often characterized by a conspicuous tail (cadophore) sprouting small trophozooids (i.e. 'nutrition zooids') also called 'gastrozooids' (i.e., feeding buds) [[Paffenhofer and Koster, 2011](https://doi.org/10.1093/plankt/fbr001); [Greer et al 2020](https://doi.org/10.1002/lno.11450)]."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1170/",
      "pav:authoredOn": "2018-03-26 13:06:59.0",
