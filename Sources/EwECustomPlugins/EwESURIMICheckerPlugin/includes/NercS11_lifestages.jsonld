      },
      "skos:definition": {
        "@language": "en",
        "@value": "The larval stage of some species of Hemichordata such as acorn worms."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1181/",
