      "skos:notation": "SDN:S11::S1182",
      "skos:altLabel": "",
      "dc:date": "2021-03-23 14:41:41.0",
      "owl:versionInfo": "2",
      "skos:prefLabel": {
        "@language": "en",
        "@value": "chalimus"
      },
      "dc:identifier": "SDN:S11::S1182",
      "skos:note": {
