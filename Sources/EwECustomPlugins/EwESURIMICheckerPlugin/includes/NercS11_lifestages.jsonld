        "@language": "en",
        "@value": "Dominant asexual stage in the life cycle of a siphonophore. Also known as the colony."
      },
      "@type": "skos:Concept"
    },
    {
      "@id": "http://vocab.nerc.ac.uk/collection/S11/current/S1176/",
      "pav:authoredOn": "2019-08-23 13:10:12.0",
      "pav:hasCurrentVersion": {
