''' <summary>
''' License class using Treek's licensing library
''' http://www.treekslicensinglibrary.com/
''' </summary>
Public Class cLicense

    Public Enum eLicenseType As Integer
        NotSet = 0
        Individual
        Team
    End Enum

    Private m_engine As TLLInterface = Nothing

    ' A bit of smartness to prevent excessive license checking
    Private m_bValidCached As Boolean = False
    Private m_lictypeCached As eLicenseType = eLicenseType.NotSet
    Private m_expCached As Date = Date.MinValue
    Private m_ownCached As String = ""

    Private m_refresh As Date = Date.MinValue

    Public Sub New()
        Me.Init()
    End Sub

    Public ReadOnly Property IsRegistered() As Boolean
        Get
            Me.Refresh()
            Return Me.m_bValidCached
        End Get
    End Property

    Public Function Unregister() As Boolean
        Try
            Me.m_engine.DeactivateLicense()
            Me.m_engine.DeleteLicenseInRegistry()
            If (Me.m_engine.CurrentLicenseFilePath IsNot Nothing) Then
                Dim fn As String = CStr(Me.m_engine.CurrentLicenseFilePath)
                System.IO.File.Delete(fn)
                Me.Init()
            End If
        Catch ex As Exception
            ' Whoah
        End Try
        Me.Invalidate()
        Return Not Me.IsRegistered()
    End Function

    Public Function ShowRegistrationForm(Owner As Form, Title As String, BuyNowURL As String, Icon As Image) As DialogResult
        Dim result As DialogResult = DialogResult.Cancel
        Try
            result = Me.m_engine.ShowRegistrationForm(Owner, Title, BuyNowURL, Icon)
        Catch ex As Exception
            ' Whoah!
        End Try
        Me.Invalidate()
        Return result
    End Function

    Public Function Expiry() As Date
        Me.Refresh()
        Return Me.m_expCached
    End Function

    Public ReadOnly Property LicenseType As eLicenseType
        Get
            Return Me.m_lictypeCached
        End Get
    End Property

    Public Function Owner() As String
        Me.Refresh()
        Return Me.m_ownCached
    End Function

