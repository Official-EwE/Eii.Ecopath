      "skos:prefLabel": {
        "@language": "en",
        "@value": "praniza"
      },
      "dc:identifier": "SDN:S11::S1191",
      "skos:note": {
        "@language": "en",
        "@value": "accepted"
      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "The juvenile form of a family of marine isopod crustaceans known as Gnathiidae. The adults are associated with sponges and occur in a wide range of depths. The praniza 'larva' is a temporary parasite of marine fishes."
      },
      "@type": "skos:Concept"
    },
    {
