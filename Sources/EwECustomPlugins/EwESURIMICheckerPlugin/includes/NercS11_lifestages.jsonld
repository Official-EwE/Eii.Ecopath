      },
      "owl:deprecated": "false",
      "void:inDataset": {
        "@id": "http://vocab.nerc.ac.uk/.well-known/void"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "Megalopae (Organisms at the final larval development stage of decapod crustaceans (e.g. crabs) following the zoea and preceding the adult stage) and adults (An animal that has reached sexual maturity) have either been grouped together or cannot be reliably distinguished."
      },
      "@type": "skos:Concept"
    },
